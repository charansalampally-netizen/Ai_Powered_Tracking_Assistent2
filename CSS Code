.question-box {
    width: 400px;
    max-width: 80%;
    padding: 12px;
    font-size: 16px;
    border: 2px solid #ccc;
    border-radius: 8px;
    margin: 20px 0;
}

.question-box:focus {
    outline: none;
    border-color: #2563eb;
}

#response {
    margin-top: 20px;
    font-size: 16px;
}

body {
    background-color: #F4F7FC;
    color: #1F2937;
}

.title {
    color: #1D4ED8;
}

.question-box {
    background-color: white;
    border: 2px solid #93C5FD;
}

.nav-btn {
    background-color: #2563EB;
    color: white;
}

.nav-btn:hover {
    background-color: #1D4ED8;
}
